#include <windows.h>
#include <commctrl.h>

1 24 "spaceviewer.manifest"
101 ICON "spaceviewer.ico"

200 DIALOGEX 0, 0, 360, 274
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SpaceViewer"
FONT 9, "Inter"
BEGIN
 CONTROL "", 201, WC_TABCONTROL, WS_TABSTOP, 8, 8, 344, 218
 CONTROL "", 202, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_ICON | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 13, 29, 334, 190
 PUSHBUTTON "", 203, 8, 233, 60, 22
 EDITTEXT 204, 72, 233, 211, 22, ES_AUTOHSCROLL
 DEFPUSHBUTTON "", IDOK, 288, 233, 64, 22
 LTEXT "", 205, 9, 260, 340, 10
END

201 DIALOGEX 0, 0, 270, 170
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SpaceViewer"
FONT 9, "Inter"
BEGIN
 CONTROL "", 211, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 14, 220, 14
 CONTROL "", 212, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 38, 220, 14
 CONTROL "", 213, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 62, 220, 14
 LTEXT "", -1, 14, 92, 125, 14
 EDITTEXT 214, 148, 88, 45, 20, ES_NUMBER
 DEFPUSHBUTTON "", IDOK, 116, 138, 64, 22
 PUSHBUTTON "", IDCANCEL, 188, 138, 64, 22
END
