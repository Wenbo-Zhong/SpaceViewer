1 24 "spaceviewer.manifest"

101 ICON "spaceviewer.ico"

#include <windows.h>
#include <commctrl.h>
#pragma code_page(65001)
200 DIALOGEX 0, 0, 360, 274
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择您的空间"
FONT 9, "Microsoft YaHei UI"
BEGIN
 CONTROL "", 201, WC_TABCONTROL, WS_TABSTOP, 8, 8, 344, 218
 CONTROL "", 202, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_ICON | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 13, 29, 334, 190
 PUSHBUTTON "路径(&P)...", 203, 8, 233, 60, 22
 EDITTEXT 204, 72, 233, 211, 22, ES_AUTOHSCROLL
 DEFPUSHBUTTON "开始", IDOK, 288, 233, 64, 22
 LTEXT "选择磁盘，或输入文件夹路径", 205, 9, 260, 340, 10
END
201 DIALOGEX 0, 0, 270, 170
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SpaceViewer 配置"
FONT 9, "Microsoft YaHei UI"
BEGIN
 CONTROL "按文件类型着色", 211, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 14, 220, 14
 CONTROL "显示可用空间", 212, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 38, 220, 14
 CONTROL "显示未知 / 未统计空间", 213, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 62, 220, 14
 LTEXT "默认展开层数 (0—6)", -1, 14, 92, 125, 14
 EDITTEXT 214, 148, 88, 45, 20, ES_NUMBER
 DEFPUSHBUTTON "确定", IDOK, 116, 138, 64, 22
 PUSHBUTTON "取消", IDCANCEL, 188, 138, 64, 22
END
